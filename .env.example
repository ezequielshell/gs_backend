# Variaveis de ambiente da API (todas opcionais; os valores abaixo sao os padroes de desenvolvimento)
DB_URL=jdbc:postgresql://localhost:5432/solo_vivo
DB_USER=solovivo
DB_PASSWORD=solovivo
PORT=8080
# Obrigatorio trocar fora do ambiente local (minimo 32 caracteres)
JWT_SECRET=dev-somente-local-troque-este-segredo-solo-vivo-2026
JWT_EXPIRACAO_MINUTOS=480
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# true = a bomba simulada recusa comandos (demonstracao do CT-08)
BOMBA_SIMULADA_FALHAR=false

# Integracao com o ESP32 (solo-vivo-arduino/sketch.ino)
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_TOPICO_BASE=fiap/iot/3esoa/tech-group/solovivo
# Opcional: por padrao e gerado um id unico (obrigatorio em broker publico)
# MQTT_CLIENT_ID=solo-vivo-api-grupo
