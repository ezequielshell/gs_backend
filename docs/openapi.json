    "/api/iot/leituras" : {
      "post" : {
        "tags" : [ "IoT" ],
        "summary" : "Recebe leituras dos sensores, gera alertas e aplica a irrigação automática",
        "description" : "Autenticado pelo header X-Device-Token (token_api do dispositivo). Exemplo: {\"leituras\":[{\"sensor\":\"Sensor de solo 01\",\"valor\":24},{\"tipo\":\"temperatura_ar\",\"valor\":31},{\"tipo\":\"umidade_ar\",\"valor\":62}]}",
        "operationId" : "receber",
        "parameters" : [ {
          "name" : "X-Device-Token",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LeiturasRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Leituras gravadas; decisões da automação na resposta",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LeiturasResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Leitura inválida (sensor desconhecido ou valor fora da faixa)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LeiturasResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Token do dispositivo ausente ou inválido",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LeiturasResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "deviceToken" : [ ]
        } ]
      }
    },
