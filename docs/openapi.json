        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AcionarIrrigacaoRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Comando confirmado pela bomba e registrado",
