  "components" : {
    "schemas" : {
      "NotificacoesDto" : {
        "type" : "object",
        "properties" : {
          "soloAbaixoLimite" : {
            "type" : "boolean"
          },
          "semLeituraSensor" : {
            "type" : "boolean"
          }
        },
        "required" : [ "semLeituraSensor", "soloAbaixoLimite" ]
      },
      "PerfilUpdateRequest" : {
        "type" : "object",
        "properties" : {
          "nome" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 160,
            "minLength" : 0
          },
          "propriedade" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "notificacoes" : {
            "$ref" : "#/components/schemas/NotificacoesDto"
          },
          "tema" : {
            "type" : "string",
            "pattern" : "claro|escuro|sistema"
          }
        },
        "required" : [ "email", "nome", "notificacoes", "propriedade" ]
      },
      "PerfilResponse" : {
        "type" : "object",
        "properties" : {
          "nome" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "propriedade" : {
            "type" : "string"
          },
          "notificacoes" : {
            "$ref" : "#/components/schemas/NotificacoesDto"
          },
          "perfil" : {
            "type" : "string"
          },
          "tema" : {
            "type" : "string"
          }
        }
      },
      "UpdateLimitesRequest" : {
        "type" : "object",
        "properties" : {
          "umidadeMin" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 100,
            "minimum" : 0
          },
          "umidadeMax" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 100,
            "minimum" : 0
          },
          "tempoMaximoMin" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 120,
            "minimum" : 1
          },
          "vazaoLMin" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 1000,
            "minimum" : 0.01
          },
          "irrigacaoAutomaticaAtivada" : {
            "type" : "boolean"
          }
        },
        "required" : [ "irrigacaoAutomaticaAtivada", "tempoMaximoMin", "umidadeMax", "umidadeMin", "vazaoLMin" ]
      },
      "CultivoResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "nome" : {
            "type" : "string"
          },
          "cultura" : {
            "type" : "string"
          },
          "sensor" : {
            "type" : "string"
          },
          "umidadeSolo" : {
            "type" : "number",
            "format" : "double"
          },
          "umidadeMin" : {
            "type" : "number",
            "format" : "double"
          },
          "umidadeMax" : {
            "type" : "number",
            "format" : "double"
          },
          "temperatura" : {
            "type" : "number",
            "format" : "double"
          },
          "umidadeAr" : {
            "type" : "number",
            "format" : "double"
          },
          "status" : {
            "type" : "string"
          },
          "mensagemStatus" : {
            "type" : "string"
          },
          "atualizadoEm" : {
            "type" : "string"
          },
          "ultimaLeituraEm" : {
            "type" : "string"
          },
          "modoIrrigacao" : {
            "type" : "string"
          },
          "irrigacaoAtiva" : {
            "type" : "boolean"
          },
          "irrigacaoAutomaticaAtivada" : {
            "type" : "boolean"
          },
          "irrigacaoPausadaMotivo" : {
            "type" : "string"
          },
          "tempoMaximoMin" : {
            "type" : "integer",
            "format" : "int32"
          },
          "vazaoLMin" : {
            "type" : "number",
            "format" : "double"
          },
          "consumoEstimadoL" : {
            "type" : "number",
            "format" : "double"
          },
          "historico24h" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MoisturePoint"
            }
          }
        }
      },
      "MoisturePoint" : {
        "type" : "object",
        "properties" : {
          "hora" : {
            "type" : "string"
          },
          "umidade" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "AlertaResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "cultivoId" : {
            "type" : "string"
          },
          "cultivoNome" : {
            "type" : "string"
          },
          "tipo" : {
            "type" : "string"
          },
          "horario" : {
            "type" : "string"
          },
          "severidade" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "mensagem" : {
            "type" : "string"
          },
          "acao" : {
            "type" : "string"
          },
          "valor" : {
            "type" : "number",
            "format" : "double"
          },
          "criadoEm" : {
            "type" : "string"
          }
        }
      },
      "LeituraItemRequest" : {
