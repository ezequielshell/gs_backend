              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CultivoResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/auth/register" : {
      "post" : {
        "tags" : [ "Autenticação" ],
