{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Solo Vivo API",
    "description" : "API REST do Solo Vivo: cultivos, limites de umidade, leituras de sensores (IoT simulado),\nirrigacao manual/automatica, alertas e historico.\n\nComo testar: faca POST /api/auth/login (maria@email.com / solovivo123), copie o token e\nclique em \"Authorize\". Os endpoints /api/iot usam o header X-Device-Token (demo-token-esp32-01).\n",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Usuários (admin)",
    "description" : "Somente perfil ADMIN"
  }, {
    "name" : "Cultivos",
    "description" : "Canteiros, limites, irrigação e histórico"
  }, {
    "name" : "Autenticação",
    "description" : "Login e cadastro (públicos)"
  }, {
    "name" : "Culturas",
    "description" : "Catálogo de culturas com limites sugeridos"
  }, {
    "name" : "IoT",
    "description" : "Entrada de leituras dos sensores (ESP32 ou simulador)"
  }, {
    "name" : "Alertas",
    "description" : "Alertas gerados pelas leituras dos sensores"
  }, {
    "name" : "Perfil",
    "description" : "Dados do usuário logado e preferências de notificação"
  } ],
